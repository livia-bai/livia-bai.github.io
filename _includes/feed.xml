{%- comment -%}
  订阅源（Atom）。参数 lang：zh 或 en，只放这种语言的版本（没有这种语言的文章就放原文）。
  只放摘要和链接：暗面的文章有自己的样式和小互动，要到网站上看才完整。
{%- endcomment -%}
{%- assign lang = include.lang -%}
{%- assign feed_url = page.url | absolute_url -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{% if lang == 'en' %}en{% else %}zh-CN{% endif %}">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{% if lang == 'en' %}{{ site.author.tagline_en | xml_escape }}{% else %}{{ site.author.tagline_zh | xml_escape }}{% endif %}</subtitle>
  <link href="{{ feed_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ feed_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  {%- assign count = 0 -%}
  {%- for post in site.posts -%}
    {%- if count >= 30 -%}{%- break -%}{%- endif -%}
    {%- assign post_lang = post.lang | default: "zh" -%}
    {%- if post_lang != lang and post.ref -%}
      {%- assign twin = site.posts | where: "ref", post.ref | where: "lang", lang | first -%}
      {%- if twin -%}{%- continue -%}{%- endif -%}
    {%- endif -%}
    {%- assign count = count | plus: 1 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    {%- if post.side == "dark" %}
    <author><name>{% if lang == 'en' %}The Dark Side of the Moon{% else %}月之暗面{% endif %}</name></author>
    <category term="dark-side" label="{% if lang == 'en' %}The Dark Side{% else %}月之暗面{% endif %}"/>
    {%- else %}
    <author><name>{{ site.author.name_en | xml_escape }}</name></author>
    <category term="bright-side" label="{% if lang == 'en' %}The Bright Side{% else %}月之亮面{% endif %}"/>
    {%- endif %}
    <summary>{{ post.excerpt | strip_html | strip_newlines | xml_escape }}</summary>
  </entry>
  {%- endfor %}
</feed>
